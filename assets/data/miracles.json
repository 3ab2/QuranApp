[
  {"id": 1, "verse": "وَجَعَلْنَا مِنَ الْمَاءِ كُلَّ شَيْءٍ حَيٍّ", "surah": "الأنبياء", "ayah": 30, "explanation": "كل الكائنات الحية أصلها الماء، وهذا ما أثبته العلم الحديث.", "audio": "https://server8.mp3quran.net/lhdan/001.mp3", "category": "كون"},
  {"id": 2, "verse": "وَالسَّمَاءَ بَنَيْنَاهَا بِأَيْدٍ وَإِنَّا لَمُوسِعُونَ", "surah": "الذاريات", "ayah": 47, "explanation": "إشارة إلى توسع الكون المستمر، وهو ما أثبته علم الفلك الحديث.", "audio": "https://server8.mp3quran.net/lhdan/002.mp3", "category": "كون"},
  {"id": 3, "verse": "وَالْجِبَالَ أَوْتَادًا", "surah": "النبأ", "ayah": 7, "explanation": "الجبال كالأوتاد تثبت القشرة الأرضية، وقد أثبت العلم الحديث ذلك.", "audio": "https://server8.mp3quran.net/lhdan/003.mp3", "category": "جيولوجيا"},
  {"id": 4, "verse": "أَوْ كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ...", "surah": "النور", "ayah": 40, "explanation": "تشير إلى ظلمات البحر العميق التي لا يصلها الضوء، وهو ما اكتشفه العلم الحديث.", "audio": "https://server8.mp3quran.net/lhdan/004.mp3", "category": "كون"},
  {"id": 5, "verse": "وَاللَّهُ خَلَقَ كُلَّ دَابَّةٍ مِنْ مَاءٍ", "surah": "النور", "ayah": 45, "explanation": "كل الكائنات الحية أصلها الماء، وهذا ما أثبته العلم الحديث.", "audio": "https://server8.mp3quran.net/lhdan/005.mp3", "category": "طب"},
  {"id": 6, "verse": "فَلَا أُقْسِمُ بِمَوَاقِعِ النُّجُومِ", "surah": "الواقعة", "ayah": 75, "explanation": "إشارة إلى دقة مواقع النجوم وبعدها الشاسع، وهو ما أثبته علم الفلك.", "audio": "https://server8.mp3quran.net/lhdan/006.mp3", "category": "كون"},
  {"id": 7, "verse": "يَخْرُجُ مِن بُطُونِهَا شَرَابٌ... فِيهِ شِفَاءٌ لِلنَّاسِ", "surah": "النحل", "ayah": 69, "explanation": "إشارة إلى فوائد العسل العلاجية، وهو ما أثبتته الدراسات الحديثة.", "audio": "https://server8.mp3quran.net/lhdan/007.mp3", "category": "طب"},
  {"id": 8, "verse": "ثُمَّ خَلَقْنَا النُّطْفَةَ عَلَقَةً...", "surah": "المؤمنون", "ayah": 14, "explanation": "وصف دقيق لمراحل تطور الجنين، وهو ما أكدته علوم الأجنة.", "audio": "https://server8.mp3quran.net/lhdan/008.mp3", "category": "طب"},
  {"id": 9, "verse": "وَأَنزَلْنَا الْحَدِيدَ...", "surah": "الحديد", "ayah": 25, "explanation": "إشارة إلى أن الحديد أصله من الفضاء، وهو ما أثبته العلم الحديث.", "audio": "https://server8.mp3quran.net/lhdan/009.mp3", "category": "كون"},
  {"id": 10, "verse": "وَهُوَ الَّذِي خَلَقَ اللَّيْلَ وَالنَّهَارَ وَالشَّمْسَ وَالْقَمَرَ كُلٌّ فِي فَلَكٍ يَسْبَحُونَ", "surah": "الأنبياء", "ayah": 33, "explanation": "إشارة إلى حركة الأجرام السماوية في مداراتها، وهو ما أثبته العلم.", "audio": "https://server8.mp3quran.net/lhdan/010.mp3", "category": "كون"},
  {"id": 11, "verse": "وَالشَّمْسُ تَجْرِي لِمُسْتَقَرٍّ لَّهَا", "surah": "يس", "ayah": 38, "explanation": "إشارة إلى حركة الشمس في الفضاء، وهو ما أثبته العلم الحديث.", "audio": "https://server8.mp3quran.net/lhdan/011.mp3", "category": "كون"},
  {"id": 12, "verse": "وَأَرْسَلْنَا الرِّيَاحَ لَوَاقِحَ", "surah": "الحجر", "ayah": 22, "explanation": "تشير إلى دور الرياح في تلقيح النباتات، وهو ما أثبته العلم.", "audio": "https://server8.mp3quran.net/lhdan/012.mp3", "category": "نبات"},
  {"id": 13, "verse": "وَالسَّمَاءَ ذَاتِ الرَّجْعِ", "surah": "الطارق", "ayah": 11, "explanation": "تشير إلى ظاهرة رجع بخار الماء للأرض (دورة الماء)، وهو ما أثبته العلم.", "audio": "https://server8.mp3quran.net/lhdan/013.mp3", "category": "كون"},
  {"id": 14, "verse": "وَجَعَلْنَا السَّمَاءَ سَقْفًا مَحْفُوظًا", "surah": "الأنبياء", "ayah": 32, "explanation": "تشير إلى حماية الغلاف الجوي للأرض من الأشعة الضارة والنيازك.", "audio": "https://server8.mp3quran.net/lhdan/014.mp3", "category": "كون"},
  {"id": 15, "verse": "وَأَرْسَلْنَا الرِّيَاحَ فَوْقَكُمْ مِدْرَارًا", "surah": "الأنعام", "ayah": 6, "explanation": "تشير إلى دور الرياح في نزول المطر.", "audio": "https://server8.mp3quran.net/lhdan/015.mp3", "category": "كون"},
  {"id": 16, "verse": "وَتَرَى الْجِبَالَ تَحْسَبُهَا جَامِدَةً وَهِيَ تَمُرُّ مَرَّ السَّحَابِ", "surah": "النمل", "ayah": 88, "explanation": "تشير إلى حركة القارات (الصفائح التكتونية) التي اكتشفها العلم الحديث.", "audio": "https://server8.mp3quran.net/lhdan/016.mp3", "category": "جيولوجيا"},
  {"id": 17, "verse": "وَفِي الْأَرْضِ آيَاتٌ لِّلْمُوقِنِينَ", "surah": "الذاريات", "ayah": 20, "explanation": "تشير إلى كثرة الآيات والدلائل في الأرض على قدرة الله، ومنها الظواهر الطبيعية.", "audio": "https://server8.mp3quran.net/lhdan/017.mp3", "category": "كون"},
  {"id": 18, "verse": "وَالسَّمَاءِ وَمَا بَنَاهَا", "surah": "الشمس", "ayah": 5, "explanation": "تشير إلى بناء السماء (الكون) بإحكام، وهو ما أثبته العلم.", "audio": "https://server8.mp3quran.net/lhdan/018.mp3", "category": "كون"},
  {"id": 19, "verse": "وَالنَّجْمِ إِذَا هَوَى", "surah": "النجم", "ayah": 1, "explanation": "تشير إلى سقوط النيازك والشهب، وهو ما يرصده العلم الحديث.", "audio": "https://server8.mp3quran.net/lhdan/019.mp3", "category": "كون"},
  {"id": 20, "verse": "وَأَرْسَلْنَا الرِّيَاحَ لَوَاقِحَ", "surah": "الحجر", "ayah": 22, "explanation": "تشير إلى دور الرياح في تلقيح النباتات، وهو ما أثبته العلم.", "audio": "https://server8.mp3quran.net/lhdan/020.mp3", "category": "نبات"},
  {"id": 21, "verse": "وَفِي أَنفُسِكُمْ أَفَلَا تُبْصِرُونَ", "surah": "الذاريات", "ayah": 21, "explanation": "تشير إلى الإعجاز في خلق الإنسان وأعضائه ووظائفه الحيوية.", "audio": "https://server8.mp3quran.net/lhdan/021.mp3", "category": "طب"},
  {"id": 22, "verse": "وَالشَّمْسَ وَالْقَمَرَ بِحُسْبَانٍ", "surah": "الرحمن", "ayah": 5, "explanation": "تشير إلى دقة حساب حركة الشمس والقمر، وهو ما أثبته العلم.", "audio": "https://server8.mp3quran.net/lhdan/022.mp3", "category": "كون"},
