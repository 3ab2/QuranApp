  {"id": 24, "verse": "وَالسَّمَاءَ رَفَعَهَا وَوَضَعَ الْمِيزَانَ", "surah": "الرحمن", "ayah": 7, "explanation": "تشير إلى توازن الكون الدقيق.", "audio": "https://server8.mp3quran.net/lhdan/024.mp3", "category": "كون"},
